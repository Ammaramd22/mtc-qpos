APP_NAME="QPOS"
APP_TITLE="QPOS"
APP_ENV=live
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Keep false on a live shop. true shows one-click demo logins on the login page.
SHOW_DEMO_SHOPS=false
# Keep false unless you want the public /business/register signup page.
ALLOW_REGISTRATION=false

# Default in config/app.php is Europe/London. Change to the shop timezone, for example Asia/Colombo.
APP_TIMEZONE=Europe/London
APP_LOCALE=en

# Software Owner login(s) — comma-separated usernames.
# These users see the hidden "Software Owner Access" panel in Business Settings
# and can enable/disable app features (Products, Labels, Invoices, etc.) for everyone else.
# Create a private user in QPOS, then put its username here. Do not share this account.
ADMINISTRATOR_USERNAMES=softwareowner

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEMINI_API_KEY=
MAC_LICENCE_CODE=

# MyReload.lk — optional platform defaults (leave empty; each business saves its own key)
MYRELOAD_ENABLED=true
MYRELOAD_API_URL=https://api.myreload.lk/v1/reload
MYRELOAD_API_USERNAME=
MYRELOAD_API_KEY=
MYRELOAD_CALLBACK_URL=
MYRELOAD_TIMEOUT=30
# Leave demo credentials unset. The Fill Demo button uses its built-in sample only.
# Do not put a live MyReload key here. Each business saves its own key in Business Settings.
