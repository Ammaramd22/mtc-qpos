# QPOS cPanel production template
# Copy this file to .env on the server and replace every placeholder.
# Do not upload a local development .env.
# Do not put this file's placeholders into the live site unchanged.

APP_NAME="QPOS"
APP_TITLE="QPOS"
# app/Console/Kernel.php runs scheduled jobs only when APP_ENV is exactly "live".
# "production" will boot the site, but backup, recurring invoices, reward points,
# payment reminders, and recurring expenses will not be scheduled.
APP_ENV=live
APP_KEY=
APP_DEBUG=false
# Public https address with no /public suffix.
APP_URL=https://YOURDOMAIN.com

SHOW_DEMO_SHOPS=false
ALLOW_REGISTRATION=false

# config/app.php defaults to Europe/London when this is omitted.
# Set the shop's real timezone, for example Asia/Colombo.
APP_TIMEZONE=Europe/London
APP_LOCALE=en

# Optional. Comma-separated usernames that may open Software Owner Access.
ADMINISTRATOR_USERNAMES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL names are usually prefixed, for example cpaneluser_qpos.
# DB_HOST is almost always localhost when the database is on the same account.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_database
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=replace_with_database_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE in this file is not read. config/session.php hardcodes "lax".

MAIL_MAILER=smtp
MAIL_HOST=mail.YOURDOMAIN.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@YOURDOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Leave blank unless that integration is actually used.
GEMINI_API_KEY=
MAC_LICENCE_CODE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
MYRELOAD_ENABLED=true
MYRELOAD_API_URL=https://api.myreload.lk/v1/reload
MYRELOAD_API_USERNAME=
MYRELOAD_API_KEY=
MYRELOAD_CALLBACK_URL=
MYRELOAD_TIMEOUT=30
