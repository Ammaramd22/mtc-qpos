DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Old addresses such as /public/login become /login.
    RewriteRule ^public/(.*)$ /$1 [R=301,L,QSA]

    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|lang|Modules)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteRule ^uploads/.*\.(htaccess|htpasswd|ini|phps|fla|psd|log|sh|zip|exe|pl|jsp|asp|htm|cgi|py|php)$ - [NC,F]
</IfModule>

<FilesMatch "(^\.env|composer\.(json|lock)|artisan|package(-lock)?\.json|\.git|.*\.(sql|log|bak|md))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule mod_php7.c>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
<IfModule mod_php8.c>
    php_value max_input_vars 10000
    php_value post_max_size 64M
    php_value upload_max_filesize 64M
</IfModule>
